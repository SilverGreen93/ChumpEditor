{
  "name": "Trainz Config",
  "caseSensitive": true,
  "languageSuffixes": true,
  "styles": {
    "default": {
      "colour": "#000000",
      "bold": false,
      "italic": false,
      "dark": "#ffffff"
    },
    "tags": {
      "colour": "#0000ff",
      "bold": false,
      "italic": false,
      "dark": "#3fd0e0"
    },
    "containers": {
      "colour": "#800000",
      "bold": false,
      "italic": false,
      "dark": "#ff9e64"
    },
    "obsolete": {
      "colour": "#ff0000",
      "bold": false,
      "italic": true,
      "dark": "#ff5f5f"
    },
    "delim_str": {
      "colour": "#008000",
      "bold": false,
      "italic": false,
      "dark": "#7ac74f"
    },
    "delim_kuid": {
      "colour": "#ff0080",
      "bold": false,
      "italic": false,
      "dark": "#ff6fb0"
    }
  },
  "pairs": [
    {
      "style": "delim_str",
      "open": "\"",
      "close": "\""
    },
    {
      "style": "delim_kuid",
      "open": "<",
      "close": ">"
    }
  ],
  "keywords": [
    {
      "style": "obsolete",
      "words": [
        "bendy",
        "tooltip-text",
        "epbrakes",
        "full-throttle-speed",
        "reskin",
        "autoanimation",
        "asset-filename",
        "origin",
        "thumbnail",
        "created",
        "company",
        "icon-texture",
        "type",
        "endlength",
        "repeats",
        "upright",
        "divider",
        "grounded",
        "uncached_alphas",
        "speedlimit",
        "initiator",
        "terminator",
        "car15",
        "car16",
        "car17",
        "car18",
        "car19",
        "car20",
        "rem",
        "night"
      ],
      "patterns": [
        "category-(era|region)-[0-9]+",
        "icon[0-9]+"
      ]
    },
    {
      "style": "tags",
      "all": "tags"
    },
    {
      "style": "containers",
      "all": "containers"
    }
  ],
  "numbers": null
}
